# Copy this file to .env and fill in the real values.
# NEVER commit .env to git.

# Supabase SESSION pooler (or direct) connection string.
# Format: jdbc:postgresql://<host>:<port>/postgres?sslmode=require
# Use the SESSION pooler URL from the Supabase Connect panel (port 5432 or 6543 with sslmode=require).
# Do NOT use the transaction pooler (port 6543 breaks Flyway).
DB_URL=jdbc:postgresql://your-host.supabase.com:5432/postgres?sslmode=require

# Supabase database user (for the pooler it looks like: postgres.<project-ref>)
DB_USERNAME=postgres.your-project-ref

# Supabase database password — NO default here; the app will refuse to start if blank.
DB_PASSWORD=

# Comma-separated list of allowed frontend origins (include both localhost and 127.0.0.1 variants)
# Example: http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: override default port 8081
# SERVER_PORT=8081
